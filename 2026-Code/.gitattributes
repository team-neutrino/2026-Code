# Set default behavior to automatically normalize line endings.
* text=auto

# Java source files
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific files (should use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts (should use LF)
*.sh text eol=lf

# Binary files (don't touch these)
*.jar binary
*.so binary
*.dll binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.hoot binary
